# =============================================================================
# cai-mcp-demo — environment. Copy to `.env` and fill in. `.env` is gitignored.
# Everything org-specific lives here so the repo is Konnect-org portable:
# no org IDs / CP names / region hosts / PATs / certs anywhere else in the repo.
# =============================================================================

# -----------------------------------------------------------------------------
# Konnect — control plane + region. `scripts/konnect-bootstrap.sh` fills the
# endpoint/server-name values below from your org given only KONNECT_TOKEN + region.
# -----------------------------------------------------------------------------
KONNECT_TOKEN=kpat_REPLACE_ME
KONNECT_REGION=us
KONNECT_CONTROL_PLANE_NAME=cai-mcp-demo

# Filled by konnect-bootstrap.sh (data-plane <-> control-plane connection):
KONNECT_CP_ENDPOINT=
KONNECT_CP_SERVER_NAME=
KONNECT_TP_ENDPOINT=
KONNECT_TP_SERVER_NAME=

# Data-plane TLS cert/key. konnect-bootstrap.sh writes these host files; the
# kong-dp container mounts ./certs at /etc/secrets/kong-cluster-cert (read-only).
CERT_HOST_DIR=./certs

# -----------------------------------------------------------------------------
# Keycloak — admin + demo secrets. NOTE: keycloak/realm-export.json is a STATIC
# import (Keycloak can't read .env), so these secrets/passwords are ALSO baked
# into that file. If you change one, change BOTH. See NOTES.md.
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Shared password for all three demo users (dana.dealer / frank.finance / olivia.ops).
DEMO_PASSWORD=Demo1234!

# Confidential client secrets (must match realm-export.json).
DEMO_CLI_SECRET=demo-cli-secret-change-me
KONG_EXCHANGE_SECRET=kong-exchange-secret-change-me
# /mcp/ops uses this confidential client for introspection + RFC 8693 token exchange.
# The clientId is a fixed realm artifact; only the secret above is sensitive. Override
# only if you rename the client in realm-export.json.
KONG_EXCHANGE_CLIENT_ID=kong-exchange

# -----------------------------------------------------------------------------
# Remote MCP passthrough targets (Phase 5).
#   REMOTE_MCP_URL        -> /mcp/remote        (local Cox-themed market-mcp; reliable default)
#   REMOTE_PUBLIC_MCP_URL -> /mcp/remote-public (real third-party MCP server)
# -----------------------------------------------------------------------------
REMOTE_MCP_URL=http://market-mcp:3000/mcp
REMOTE_PUBLIC_MCP_URL=https://mcp.deepwiki.com/mcp

# -----------------------------------------------------------------------------
# Host debug ports for the upstream containers (real traffic goes through Kong
# on :8000 — these are only for local curling/smoke tests). Override any that
# collide with a local dev server. Internal container port is always 3000.
# -----------------------------------------------------------------------------
DEALER_SVC_PORT=3001
FINANCE_SVC_PORT=3002
MARKET_MCP_PORT=3003
